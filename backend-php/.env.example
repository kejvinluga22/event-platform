# ---- Application ----
APP_NAME="Smart Event Platform"
APP_ENV=local
APP_DEBUG=true
APP_BASE_URL=http://localhost/backend-php/api
FRONTEND_URL=http://localhost:5173

# ---- Database (XAMPP MySQL defaults) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_event
DB_USER=root
DB_PASS=

# ---- Security ----
JWT_SECRET=replace-with-a-long-random-string
QR_SECRET=replace-with-a-different-long-random-string
JWT_ISSUER=smart-event-platform
JWT_TTL=3600

# ---- Mail providers (fill the ones you use) ----
MAIL_FROM=no-reply@smartevent.local
MAIL_FROM_NAME="Smart Event"
GMAIL_USER=
GMAIL_PASS=
OUTLOOK_USER=
OUTLOOK_PASS=
SENDGRID_KEY=
MAILGUN_USER=
MAILGUN_PASS=
BREVO_USER=
BREVO_PASS=
